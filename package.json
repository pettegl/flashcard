{
  "name": "flashcard",
  "version": "0.1.0",
  "private": true,
  "description": "Offline flashcard literacy game for the Curious Reader container",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pettegl/flashcard.git"
  },
  "engines": {
    "node": ">=20",
    "npm": ">=10"
  },
  "browserslist": [
    "chrome >= 80",
    "ios_saf >= 13"
  ],
  "scripts": {
    "dev": "npm run fixtures && webpack serve --mode development",
    "build": "webpack --mode production",
    "build:merged": "node scripts/build-merged.mjs",
    "fixtures": "node scripts/make-fixtures.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "jest --coverage",
    "test:e2e": "playwright test",
    "audit:standalone": "node scripts/audit-standalone.mjs",
    "package": "node scripts/package.mjs",
    "verify:release": "node scripts/verify-release.mjs"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@babel/core": "^7.29.13",
    "@babel/preset-env": "^7.29.7",
    "@babel/preset-react": "^7.29.7",
    "@babel/preset-typescript": "^7.29.7",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/jest": "^29.5.14",
    "@types/node": "^20.19.43",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "babel-jest": "^29.7.0",
    "babel-loader": "^10.1.1",
    "copy-webpack-plugin": "^14.0.0",
    "css-loader": "^7.1.5",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "html-webpack-plugin": "^5.6.8",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "mini-css-extract-plugin": "^2.10.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1",
    "webpack": "^5.112.2",
    "webpack-cli": "^7.3.1",
    "webpack-dev-server": "^6.1.0"
  }
}
